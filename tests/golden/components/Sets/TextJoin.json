     "b",
     "c"
    ]
   },
   "expect": {
    "result": {
     "{0}": [
      "abc"
     ]
    }
   }
  },
  {
   "name": "separator",
   "inputs": {
    "text": [
     "a",
     "b",
     "c"
    ],
    "join": ", "
   },
   "expect": {
    "result": {
     "{0}": [
      "a, b, c"
     ]
    }
   }
  },
  {
   "name": "numbers_are_formatted",
   "inputs": {
    "text": [
     1.0,
     2.5,
     true,
     1e-07
    ],
    "join": "|"
   },
   "expect": {
    "result": {
     "{0}": [
      "1|2.5|True|1E-07"
     ]
    }
   }
  },
  {
   "name": "per_branch_with_empty",
   "inputs": {
    "text": {
     "0": [
      "x",
      "y"
     ],
     "1": []
    },
    "join": "-"
   },
   "expect": {
    "result": {
     "{0}": [
      "x-y"
     ],
